# A window larger than the room behind stop, and the packet that says stop lost
# found by linksearch --rules hl-refuse,window=4,number_bits=4
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=4 reask=96 pass=16 restart_words=1 delay=1 words=1 images=0 window0=0 wrong=0 still=0
packets 5 0 0 0
offer 0 1 217
offer 0 1 256
offer 0 1 288
fate 0 7 header
offer 0 1 328
offer 0 1 361
quiet 579 20000
run hl-refuse,window=4,number_bits=4 fail queue overrun
run hl,window=4,number_bits=4 ok
