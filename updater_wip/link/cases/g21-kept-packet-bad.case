# QUESTIONS.md G21: a bit flips in a packet the sender keeps
# found by linksearch --rules proposed-check_kept
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=4 delay=1 words=1 images=0
packets 2 0 1 0
offer 0 1 128
flip 0 1 145
quiet 160 20000
run proposed-check_kept fail nothing more goes wrong, and it does not finish
run proposed ok
