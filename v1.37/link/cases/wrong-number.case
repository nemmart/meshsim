# A packet is lost; the next arrives good and ahead of the one expected. Without a rule for it nothing is ever asked (HL, 'When a packet is bad')
# found by linksearch --rules hl-resend_ahead-zero_number
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=8 reask=96 pass=16 restart_words=1 delay=1 words=1 images=0 window0=0 wrong=0 still=0
packets 2 0 2 0
offer 0 1 217
fate 0 5 gone
quiet 256 20000
run hl-resend_ahead-zero_number fail a sender stood still
run hl ok
