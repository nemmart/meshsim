# The last packet of a burst is lost, and nothing sends it again: the empty packet's number is what shows it
# found by linksearch --rules hl-zero_number
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=8 reask=96 pass=1 restart_words=1 delay=1 words=1 images=0 window0=0 wrong=0 still=0
packets 2 0 2 0
offer 0 1 216
offer 1 1 216
offer 0 1 233
fate 0 6 gone
quiet 280 20000
run hl-zero_number fail a sender stood still
run hl ok
