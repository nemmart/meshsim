# QUESTIONS.md G7: the last packet of a burst is lost, and nothing sends it again
# found by linksearch --rules as_written+resend_ahead
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=4 delay=1 words=1 images=0
packets 2 0 2 0
offer 0 1 0
offer 1 1 0
offer 0 1 32
fate 0 2 gone
quiet 56 20000
run as_written+resend_ahead fail nothing more goes wrong, and it does not finish
run as_written+resend_ahead+zero_number ok
run as_written+resend_ahead,resend_timer=96 ok
run proposed ok
