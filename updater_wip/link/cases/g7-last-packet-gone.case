# QUESTIONS.md G7: the last packet of a burst is lost, and nothing sends it again
# found by linksearch --rules as_written+resend_ahead
sizes number_bits=3 max_words=1 window=2 zeros=44 flush_zeros=36 status_timer=24 queue=8 reask=96 delay=1 words=1 images=0 window0=0 wrong=0 still=0
packets 2 0 2 0
offer 0 1 0
offer 1 1 0
offer 0 1 36
fate 0 2 gone
quiet 60 20000
run as_written+resend_ahead fail a sender stood still
run as_written+resend_ahead+zero_number ok
run as_written+resend_ahead,resend_timer=96 ok
run proposed ok
