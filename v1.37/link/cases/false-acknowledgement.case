# A forged acknowledge field releases a packet that was lost on the wire. HL: the other end asks for it, the sender no longer keeps it: the error, and the link starts again
# found by linksearch --rules hl-ask_not_kept
sizes number_bits=3 max_words=1 window=2 zeros=40 flush_zeros=32 status_timer=24 queue=8 reask=96 pass=16 restart_words=1 delay=1 words=1 images=0 window0=0 wrong=0 still=0
packets 1 0 1 0
offer 0 1 217
fate 0 5 gone
fate 1 5 forge-ack
quiet 264 20000
run hl-ask_not_kept fail nothing more goes wrong, and it does not finish
run hl ok
